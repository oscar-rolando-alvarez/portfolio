# Copy to .env and fill in. Never commit the real .env file.

POSTGRES_PASSWORD=

# Base64 HMAC key used to validate demo tokens minted by scripts/dev-token.sh.
# Generate with: openssl rand -base64 32
JWT_SIGNING_KEY_BASE64=

# Optional AI summaries via any OpenAI-compatible endpoint (OpenAI, Azure OpenAI v1, Ollama, vLLM, LiteLLM...).
AI_ENABLED=false
AI_ENDPOINT=http://host.docker.internal:11434/v1
AI_MODEL=llama3.2
AI_API_KEY=
