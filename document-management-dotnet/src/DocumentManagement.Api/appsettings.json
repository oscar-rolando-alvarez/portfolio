{
  "ConnectionStrings": {
    "documentsdb": "Host=localhost;Port=5432;Database=documentsdb;Username=postgres;Password=postgres"
  },
  "Authentication": {
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [ "document-management-api" ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  },
  "Documents": {
    "MaxUploadBytes": 52428800
  },
  "Storage": {
    "Provider": "FileSystem",
    "RootPath": "storage",
    "S3": {
      "BucketName": "documents",
      "ServiceUrl": "",
      "Region": "us-east-1",
      "ForcePathStyle": true
    }
  },
  "AI": {
    "Enabled": false,
    "Endpoint": "http://localhost:11434/v1",
    "Model": "llama3.2",
    "ApiKey": "",
    "MaxInputCharacters": 12000
  },
  "Database": {
    "EnsureCreated": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
