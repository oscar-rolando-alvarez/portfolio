# Development image: rebuilds and restarts the node when sources change.
FROM rust:1.99.1-slim-trixie

RUN cargo install --locked cargo-watch

WORKDIR /app
ENV RUST_LOG=debug \
    RUST_BACKTRACE=1

EXPOSE 8080 8333

CMD ["cargo", "watch", "-x", "run --bin blockchain-node -- --data-dir /data --api-host 0.0.0.0 --api-port 8080 --p2p-port 8333 --network development"]
