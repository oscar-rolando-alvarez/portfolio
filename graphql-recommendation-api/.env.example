# Copy to .env and adjust. Never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# SQLite by default (zero setup); PostgreSQL in docker compose / production
DATABASE_URL=sqlite+aiosqlite:///./recommender.db
SEED_DEMO_DATA=true

# Optional Redis cache for recommendation results (in-process TTL cache when unset)
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

JWT_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000"]
GRAPHQL_MAX_DEPTH=8
GRAPHQL_IDE=true

# Embeddings: fake (deterministic hashing, default) | openai (any OpenAI-compatible endpoint)
EMBEDDING_PROVIDER=fake
# e.g. https://api.openai.com/v1, http://localhost:11434/v1 (Ollama), http://localhost:4000 (LiteLLM proxy)
LLM_BASE_URL=
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
# Set false for servers that do not support the `dimensions` parameter (e.g. some Ollama models)
EMBEDDING_SEND_DIMENSIONS=true

# Vector store: memory (in-process NumPy) | qdrant
VECTOR_STORE=memory
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=items

# Hybrid weights
WEIGHT_COLLABORATIVE=0.4
WEIGHT_CONTENT=0.2
WEIGHT_SEMANTIC=0.3
WEIGHT_POPULARITY=0.1

# Optional OpenTelemetry tracing (requires: uv sync --extra otel)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
