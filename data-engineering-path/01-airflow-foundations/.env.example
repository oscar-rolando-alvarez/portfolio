# Copy to .env and adjust. Everything here is a local-development default, never a real secret.
AIRFLOW_UID=50000
AIRFLOW_PORT=8081
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
# api = call Open-Meteo; fixture = bundled sample, works offline
WEATHER_SOURCE_MODE=api
