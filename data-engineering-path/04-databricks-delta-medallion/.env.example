# Copy to .env and adjust. Local-development defaults only; never commit real values.
AIRFLOW_UID=50000
AIRFLOW_PORT=8084
DATABRICKS_LOCAL_PORT=8090
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# local = databricks-local container (no account) | databricks = real workspace
MEDALLION_TARGET=local

# --- Only for MEDALLION_TARGET=databricks -------------------------------------
# Connection as URI: databricks://:<token>@<workspace-host>   (prefer an OAuth service
# principal: {"conn_type":"databricks","host":"...","login":"<client-id>","password":"<secret>",
#  "extra":{"service_principal_oauth":true}})
# AIRFLOW_CONN_DATABRICKS_DEFAULT=
DATABRICKS_GIT_URL=https://github.com/<you>/portfolio
DATABRICKS_GIT_BRANCH=master
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=clickstream
DATABRICKS_CLUSTER_POLICY_ID=
