# Copy to .env and adjust. Local-development defaults only; never commit real values.
AIRFLOW_UID=50000
AIRFLOW_PORT=8082
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# duckdb = local, no account needed | snowflake = real account (connection below)
WAREHOUSE_BACKEND=duckdb
WAREHOUSE_POOL_SLOTS=1

# Snowflake connection as an Airflow connection in JSON form (key-pair auth recommended).
# Shape only; put your own values in .env:
# AIRFLOW_CONN_SNOWFLAKE_DEFAULT='{"conn_type":"snowflake","login":"LOADER_SVC","schema":"RAW","extra":{"account":"<org>-<account>","warehouse":"LOAD_WH","database":"ANALYTICS","role":"LOADER","private_key_file":"/opt/airflow/secrets/rsa_key.p8"}}'
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=
