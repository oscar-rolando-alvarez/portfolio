# Copy to .env and adjust. Local-development defaults only; never commit real values.
AIRFLOW_UID=50000
AIRFLOW_PORT=8083
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change-me
POSTGRES_PASSWORD=change-me
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# Local: duckdb + local. Snowflake: WAREHOUSE_BACKEND=snowflake and DBT_TARGET=snowflake.
WAREHOUSE_BACKEND=duckdb
WAREHOUSE_POOL_SLOTS=1
DBT_TARGET=local

# Loader connection (see Level 2 for the JSON shape)
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=
# dbt profile (key-pair auth; mount the key file, never paste it here)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
