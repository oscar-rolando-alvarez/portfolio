# Copy to .env and adjust. Never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# SQLite by default (zero setup); PostgreSQL in docker compose / production
DATABASE_URL=sqlite+aiosqlite:///./financial_analysis.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/financial_analysis
DB_ECHO=false

# JWT (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JSON list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000"]

# GenAI narrative reports: fake (deterministic, default) | openai (any OpenAI-compatible API) | disabled
LLM_PROVIDER=fake
# e.g. https://api.openai.com/v1, http://localhost:11434/v1 (Ollama), http://localhost:4000 (LiteLLM proxy)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2

# Risk analytics
RISK_FREE_RATE=0.02
TRADING_DAYS_PER_YEAR=252

# Optional OpenTelemetry tracing (requires: uv sync --extra otel)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
