# Copy to .env. Nuxt maps NUXT_* variables onto runtimeConfig at runtime;
# DATABASE_URL is shared by the app and the Prisma CLI (prisma.config.ts loads .env).

# PostgreSQL connection string
DATABASE_URL=postgresql://social:social@localhost:5432/socialconnect

# Secret for signing access-token JWTs (HS256). Required when NODE_ENV=production.
# Generate with: openssl rand -base64 48
NUXT_JWT_SECRET=

# Token lifetimes in seconds
NUXT_ACCESS_TOKEN_TTL=900
NUXT_REFRESH_TOKEN_TTL=2592000

# Set to false only when serving over plain HTTP on a non-localhost host
NUXT_COOKIE_SECURE=true

# Content moderation: none | keyword (default, offline) | llm (any OpenAI-compatible API)
NUXT_MODERATION_PROVIDER=keyword
# Only for provider=llm, e.g. a LiteLLM proxy, vLLM, Ollama (http://localhost:11434/v1) or a hosted API
NUXT_MODERATION_BASE_URL=
NUXT_MODERATION_API_KEY=
NUXT_MODERATION_MODEL=

# HTTP listener for the production server
HOST=0.0.0.0
PORT=3000
