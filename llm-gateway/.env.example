# Copy to .env and adjust. Never commit real secrets.

# --- gateway ---------------------------------------------------------------
GATEWAY_CONFIG=configs/gateway.yaml          # or configs/gateway.openai.yaml
GATEWAY_LISTEN_ADDR=:8080
GATEWAY_LOG_LEVEL=info
GATEWAY_REDIS_URL=                           # e.g. redis://localhost:6379/0 (empty = in-memory)
# SHA-256 of the admin bearer token: go run ./cmd/gateway -hash-key '<token>'
GATEWAY_ADMIN_KEY_SHA256=
GATEWAY_DEFAULT_KEY_SHA256=
GATEWAY_AUDIT_ENABLED=true
GATEWAY_AUDIT_PATH=stdout

# --- observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=                 # e.g. http://localhost:4318

# --- OpenAI-compatible upstreams (configs/gateway.openai.yaml) ----------------
LLM_BASE_URL=https://api.openai.com/v1       # Azure OpenAI: https://<res>.openai.azure.com/openai/v1
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization             # Azure OpenAI: api-key
LLM_CHAT_MODEL=gpt-4o-mini
LLM_CHAT_INPUT_COST=0.15                     # USD per 1M input tokens (your contract price)
LLM_CHAT_OUTPUT_COST=0.60
LLM_EMBED_MODEL=text-embedding-3-small
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1   # e.g. Ollama or vLLM
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_CHAT_MODEL=llama3.1:8b
