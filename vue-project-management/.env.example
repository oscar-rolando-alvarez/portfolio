# Copy to .env and adjust. Nuxt maps NUXT_* variables onto runtimeConfig at runtime.

# Secret used to sign session JWTs (HS256). Required when NODE_ENV=production.
# Generate with: openssl rand -base64 48
NUXT_JWT_SECRET=

# Session lifetime in seconds (default 8 hours)
NUXT_SESSION_MAX_AGE=28800

# Set to false only when serving over plain HTTP on a non-localhost host
NUXT_COOKIE_SECURE=true

# Display name shown in the sidebar
NUXT_PUBLIC_APP_NAME=Vue PM

# HTTP listener for the production server (node .output/server/index.mjs)
HOST=0.0.0.0
PORT=3000
