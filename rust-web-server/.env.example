# Copy to .env and adjust. Never commit real secrets.
# Nested keys use a double underscore: APP_<SECTION>__<KEY>.

# Server
APP_HOST=0.0.0.0
APP_PORT=8080
APP_WORKERS=4
APP_MAX_CONNECTIONS=25000
APP_REQUEST_TIMEOUT=30
APP_SHUTDOWN_TIMEOUT=30
APP_ENVIRONMENT=development
APP_UPLOAD_DIR=./uploads
APP_STATIC_DIR=./static
# Comma-separated list, or * to allow any origin
APP_CORS_ALLOWED_ORIGINS=*

# PostgreSQL
APP_DATABASE__URL=postgres://postgres:postgres@localhost:5432/rust_web_server
APP_DATABASE__MAX_CONNECTIONS=20
APP_DATABASE__MIN_CONNECTIONS=2
APP_DATABASE__ACQUIRE_TIMEOUT=10
APP_DATABASE__IDLE_TIMEOUT=600
APP_DATABASE__MAX_LIFETIME=1800

# Redis
APP_REDIS__URL=redis://localhost:6379
APP_REDIS__TIMEOUT=5

# JWT (required, >= 32 chars, when APP_ENVIRONMENT=production)
APP_JWT__SECRET=replace-with-a-long-random-secret-value
APP_JWT__EXPIRATION=3600
APP_JWT__REFRESH_EXPIRATION=604800
APP_JWT__ALGORITHM=HS256
APP_JWT__ISSUER=rust-web-server

# Rate limiting (per client IP)
APP_RATE_LIMIT__ENABLED=true
APP_RATE_LIMIT__REQUESTS_PER_MINUTE=120
APP_RATE_LIMIT__BURST_SIZE=30

# Logging: json | pretty | compact. RUST_LOG overrides the level.
APP_LOGGING__LEVEL=info
APP_LOGGING__FORMAT=json
RUST_LOG=info,sqlx=warn

# OpenTelemetry (optional): set to export traces over OTLP/HTTP
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
