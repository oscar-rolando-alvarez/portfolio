    "date-fns": "^4.4.0",
    "immer": "^11.1.21",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.4",
