# Copy to .env.local and adjust. Never commit real secrets.

# Public URL of the app (used for metadata / Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Real-time streaming via Socket.IO (optional). Disabled by default so the
# dashboard runs standalone with its built-in demo dataset.
NEXT_PUBLIC_ENABLE_REALTIME=false
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Natural-language insights (optional). Any OpenAI-compatible endpoint works:
# a hosted provider, a LiteLLM proxy, vLLM, Ollama (http://localhost:11434/v1), LM Studio...
# Leave AI_BASE_URL or AI_MODEL empty to use the deterministic rule-based insights.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
