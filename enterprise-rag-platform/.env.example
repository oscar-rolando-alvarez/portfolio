# Copy to .env. Every variable is optional: defaults run fully offline with fake providers.

# --- storage (unset = in-memory store, demo/tests only) ---
# RAG_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
# RAG_EMBEDDING_DIM=384            # must match the vector column; changing it needs a re-index

# --- auth ---
RAG_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# RAG_JWT_ALGORITHM=RS256          # with RAG_JWT_PUBLIC_KEY from your IdP
# RAG_JWT_ISSUER=https://login.example.com/
# RAG_JWT_AUDIENCE=rag-platform
RAG_ALLOW_DEV_TOKENS=true          # set false in production

# --- chat model: any OpenAI-compatible endpoint (OpenAI, Azure OpenAI v1, vLLM, Ollama, LiteLLM) ---
# RAG_LLM_PROVIDER=openai
# RAG_LLM_BASE_URL=https://api.openai.com/v1      # e.g. http://localhost:11434/v1 for Ollama
# RAG_LLM_API_KEY=sk-...
# RAG_LLM_MODEL=gpt-4o-mini

# --- embeddings: any OpenAI-compatible /embeddings endpoint ---
# RAG_EMBEDDING_PROVIDER=openai
# RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_API_KEY=sk-...
# RAG_EMBEDDING_MODEL=text-embedding-3-small

# --- retrieval ---
# RAG_RERANKER=lexical             # none | lexical | http | llm
# RAG_RERANKER_URL=http://reranker:8080/rerank   # TEI / Infinity / vLLM compatible
# RAG_QUERY_REWRITER=heuristic     # heuristic | llm
# RAG_MIN_RELEVANCE=0.12
# RAG_INJECTION_POLICY=drop        # drop | annotate

# --- cost accounting (USD per 1K tokens, JSON) ---
# RAG_MODEL_PRICING={"gpt-4o-mini":{"input":0.00015,"output":0.0006},"text-embedding-3-small":{"input":0.00002,"output":0}}

# --- observability ---
# RAG_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# RAG_LOG_LEVEL=INFO
