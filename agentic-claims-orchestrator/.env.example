# ---------------------------------------------------------------------------
# agentic-claims-orchestrator - example configuration (copy to .env)
# Every value is validated at startup (apps/server/src/config.ts).
# The values below are for LOCAL DEVELOPMENT ONLY. Never reuse them anywhere else.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Persistence: postgres | memory
STORAGE=postgres
DATABASE_URL=postgres://claims:claims@localhost:5432/claims
RUN_MIGRATIONS=true

# LLM: fake (deterministic, offline) | openai_compatible (OpenAI, Azure OpenAI v1, vLLM, Ollama, LiteLLM, ...)
LLM_PROVIDER=fake
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_AUTH_HEADER=authorization        # or "api-key" for Azure OpenAI
# LLM_MODEL=llama3.1:8b
# LLM_PROVIDER_NAME=ollama
LLM_TIMEOUT_MS=30000
# Pricing used for cost accounting and budgets (USD per 1M tokens)
LLM_INPUT_PRICE_PER_MTOK=0.15
LLM_OUTPUT_PRICE_PER_MTOK=0.60

# Per-run budgets (fail safe: a run that exceeds one is stopped and left for a human)
BUDGET_MAX_ITERATIONS=20
BUDGET_MAX_LLM_TOKENS=24000
BUDGET_MAX_COST_USD=0.25
BUDGET_MAX_TOOL_CALLS=40
BUDGET_MAX_WALL_CLOCK_MS=600000
STEP_TIMEOUT_MS=30000
STEP_MAX_ATTEMPTS=3

# MCP tool servers: in-process | stdio (stdio requires STORAGE=postgres and explicit PII keys)
MCP_TRANSPORT=in-process
MCP_TOOL_TIMEOUT_MS=10000
# POLICY_FILE=./config/claims-policy.json

# PII vault: 32-byte base64 AES-256-GCM key + HMAC secret for deterministic tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY=2jsGITSW9/L/RQYDOWNkFnHfIIHyrtIVU/9X9DegGUE=
PII_TOKEN_SECRET=263f2d62def85713e10ddc82c44e82a19af72fd80fa42ba9

# API keys are configured as SHA-256 hashes. Dev keys (plaintext, for curl):
#   dev-intake-key-change-me | dev-adjuster-key-change-me | dev-senior-key-change-me
#   dev-siu-key-change-me    | dev-auditor-key-change-me  | dev-operator-key-change-me
API_KEYS=[{"id":"portal-intake","tenantId":"acme","roles":["claims_intake"],"sha256":"7524ba3c107510bb2e9afa47ea13559cb0f9db30361e6f8bc22d25d2ead4a78b"},{"id":"ann.adjuster","tenantId":"acme","roles":["adjuster"],"sha256":"5d4d3f8e9f8d8b44b5e9cfaf0ffb755cd4aec0ba8c57373078bf38a909f876d9"},{"id":"sam.senior","tenantId":"acme","roles":["senior_adjuster"],"sha256":"23ca84be2d1e208fc1bfd1ac510ccbcac41a29e061e24b0a8628e6f4f26f9608"},{"id":"sia.siu","tenantId":"acme","roles":["siu_investigator"],"sha256":"3d2dbd6ff785805da72ec5212f8b3a36d0ae04af108700b8800aa67cbdb15b10"},{"id":"aud.auditor","tenantId":"acme","roles":["auditor"],"sha256":"ca607614430a39df4f015ee467aa84901832500a7b364cb246a1a5616a1f8262"},{"id":"ops.operator","tenantId":"acme","roles":["operator"],"sha256":"10eb2df1ce0b95f9a08e4057f95f73b0d527a30ae87ce2622b6d3f9b68b6177c"}]

# Observability (OTLP/HTTP). Unset = no export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agentic-claims-orchestrator
RECOVERY_INTERVAL_MS=30000
