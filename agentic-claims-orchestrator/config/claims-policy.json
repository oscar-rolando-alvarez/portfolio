{
  "id": "claims-triage-guardrails",
  "version": "2026.10.1",
  "description": "Human-in-the-loop, invariant and data-handling rules for automated claims triage. Owned by Claims Operations + Compliance; changes require review (see docs/adr/0004-declarative-policy-engine.md).",
  "approvalRolePriority": ["siu_investigator", "senior_adjuster", "adjuster"],
  "rules": [
    {
      "id": "HITL-SIU-HIGH-FRAUD",
      "description": "Fraud-risk score >= 0.70 must be reviewed by the Special Investigations Unit.",
      "stage": "decision",
      "when": { "field": "fraud.score", "op": "gte", "value": 0.7 },
      "effect": "require_approval",
      "role": "siu_investigator"
    },
    {
      "id": "HITL-HIGH-PAYOUT",
      "description": "Proposed payouts above 10,000 USD require senior adjuster approval.",
      "stage": "decision",
      "when": {
        "all": [
          { "field": "decision.outcome", "op": "eq", "value": "approve" },
          { "field": "decision.payoutAmount", "op": "gt", "value": 10000 }
        ]
      },
      "effect": "require_approval",
      "role": "senior_adjuster"
    },
    {
      "id": "HITL-MEDIUM-FRAUD",
      "description": "Approvals with a medium fraud-risk score (>= 0.30) require adjuster review.",
      "stage": "decision",
      "when": {
        "all": [
          { "field": "decision.outcome", "op": "eq", "value": "approve" },
          { "field": "fraud.score", "op": "gte", "value": 0.3 }
        ]
      },
      "effect": "require_approval",
      "role": "adjuster"
    },
    {
      "id": "HITL-DENIAL",
      "description": "No claim is denied without a human: every proposed denial goes to an adjuster (regulatory fairness).",
      "stage": "decision",
      "when": { "field": "decision.outcome", "op": "eq", "value": "deny" },
      "effect": "require_approval",
      "role": "adjuster"
    },
    {
      "id": "HITL-PROMPT-INJECTION",
      "description": "Claims whose free text attempted to instruct the AI are reviewed by an adjuster.",
      "stage": "decision",
      "when": { "field": "intake.flags", "op": "contains", "value": "prompt_injection_suspected" },
      "effect": "require_approval",
      "role": "adjuster"
    },
    {
      "id": "HITL-DOC-DISCREPANCY",
      "description": "Claimed amount deviates > 20% from documented amount: adjuster review.",
      "stage": "decision",
      "when": { "field": "extraction.consistency", "op": "eq", "value": "discrepancy" },
      "effect": "require_approval",
      "role": "adjuster"
    },
    {
      "id": "HITL-NO-DOCUMENTATION",
      "description": "Approvals without any amount-bearing document require adjuster review.",
      "stage": "decision",
      "when": {
        "all": [
          { "field": "decision.outcome", "op": "eq", "value": "approve" },
          { "field": "extraction.consistency", "op": "eq", "value": "insufficient" }
        ]
      },
      "effect": "require_approval",
      "role": "adjuster"
    },
    {
      "id": "BLOCK-PAYOUT-OVER-LIMIT",
      "description": "Invariant: a proposed payout can never exceed the policy coverage limit.",
      "stage": "decision",
      "when": { "field": "decision.payoutAmount", "op": "gt", "ref": "coverage.coverageLimit" },
      "effect": "block"
    },
    {
      "id": "BLOCK-FINAL-PAYOUT-OVER-LIMIT",
      "description": "Invariant (applies to human overrides too): the final payout can never exceed the coverage limit.",
      "stage": "finalize",
      "when": { "field": "final.payoutAmount", "op": "gt", "ref": "coverage.coverageLimit" },
      "effect": "block"
    },
    {
      "id": "BLOCK-PAYOUT-UNCOVERED",
      "description": "Invariant: no payout on a claim the coverage step did not confirm.",
      "stage": "finalize",
      "when": {
        "all": [
          { "field": "final.payoutAmount", "op": "gt", "value": 0 },
          { "not": { "field": "coverage.covered", "op": "eq", "value": true } }
        ]
      },
      "effect": "block"
    }
  ],
  "dataPolicies": [
    {
      "id": "DP-PII-NO-EGRESS",
      "description": "Raw PII (names, emails, phones, SSNs, card numbers, document bodies) is tokenized at the edge and resolved only inside the PII-privileged document_extract tool. It must never reach an LLM prompt, the audit trail, logs or API responses.",
      "classification": "pii",
      "sourceTools": ["document_extract"],
      "deniedSinks": ["llm", "audit", "logs", "api"]
    }
  ],
  "toolGrants": {
    "intake": [],
    "extraction": ["document_extract"],
    "coverage": ["policy_lookup"],
    "fraudRisk": ["claims_history"],
    "decision": [],
    "finalize": []
  }
}
