# Copy to .env (never commit it). docker compose reads these for the platform service.
# Everything works offline with the defaults below (fake LLM + fixture enrichment).

# --- LLM (any OpenAI-compatible endpoint: OpenAI, Azure OpenAI v1, vLLM, Ollama, LiteLLM) ---
FLEETINTEL_LLM_PROVIDER=fake            # fake | openai_compatible
FLEETINTEL_LLM_BASE_URL=https://api.openai.com/v1
FLEETINTEL_LLM_API_KEY=
FLEETINTEL_LLM_MODEL=gpt-4o-mini
# e.g. local Ollama: FLEETINTEL_LLM_BASE_URL=http://host.docker.internal:11434/v1  FLEETINTEL_LLM_MODEL=llama3.1

# --- Enrichment providers ---
FLEETINTEL_ENRICHMENT_MODE=fake         # fake | live (Open-Meteo needs no key)
FLEETINTEL_OPENCELLID_API_KEY=
FLEETINTEL_STATUS_FEED_URL=             # Statuspage-compatible .../api/v2/incidents/unresolved.json

# --- API keys: tenant:sha256(key) pairs; only hashes are configured ---
# printf 'my-key' | shasum -a 256
FLEETINTEL_API_KEYS=acme-utilities:8649cdebee753898fd50e01408a9e438aa5090249bc3e51b65f33dce973b0873
