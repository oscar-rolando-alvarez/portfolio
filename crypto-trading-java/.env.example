# Copy to .env and adjust. Never commit real secrets.
# Leave optional variables commented out rather than empty.
DB_NAME=crypto_trading
DB_USERNAME=crypto_user
DB_PASSWORD=crypto_password

# Base64 or raw string of at least 256 bits. Generate with: openssl rand -base64 32
# JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

LOG_LEVEL=INFO
# JSON console logs: ecs | logstash | gelf
LOGGING_STRUCTURED_FORMAT_CONSOLE=ecs

# Tracing (OpenTelemetry via Micrometer Tracing)
TRACING_SAMPLING_PROBABILITY=0.1
# MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://jaeger:4318/v1/traces

# Risk limits
RISK_MAX_POSITION_SIZE=1000000
RISK_MAX_DAILY_LOSS=100000
RISK_MAX_DRAWDOWN=0.2
RISK_MARGIN_REQUIREMENT=0.1
