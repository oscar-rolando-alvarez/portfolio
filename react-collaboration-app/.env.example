# ---- Server (node server/index.ts) ----
PORT=3001
# Comma-separated browser origins allowed by CORS / Socket.IO.
CLIENT_URL=http://localhost:3000
# debug | info | warn | error
LOG_LEVEL=info

# ---- Client (Vite, read at build time) ----
# Socket.IO endpoint. Defaults to http://localhost:3001 in dev and to the page
# origin in production builds (the server hosts the SPA).
# VITE_SERVER_URL=http://localhost:3001
