{
  "name": "react-collaboration-app",
  "version": "2.0.0",
  "description": "Real-time collaborative whiteboard (Figma/Miro-style) with live cursors, OT sync and WebRTC",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docker:build": "docker build -t react-collaboration-app .",
    "docker:run": "docker run --rm -p 3001:3001 react-collaboration-app"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/simple-peer": "^9.11.9",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fabric": "^7.4.0",
    "globals": "^17.13.0",
    "immer": "^11.1.21",
    "jsdom": "^30.1.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.3.3",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "uuid": "^14.0.3",
    "vite": "^8.3.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
