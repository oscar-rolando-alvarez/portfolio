# Copy to .env and adjust. Never commit real secrets.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]

# Upload safety limits
MAX_UPLOAD_MB=10
MAX_PIXELS=40000000
MAX_OUTPUT_DIMENSION=8000
ALLOWED_FORMATS=["JPEG","PNG","WEBP","GIF","BMP","TIFF"]

# Where stored originals are written
STORAGE_DIR=./data/images

# Vision captioning: fake (deterministic, default) | openai (any OpenAI-compatible API) | disabled
VISION_PROVIDER=fake
# e.g. https://api.openai.com/v1, http://localhost:11434/v1 (Ollama), http://localhost:4000 (LiteLLM proxy)
LLM_BASE_URL=
LLM_API_KEY=
LLM_VISION_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
VISION_MAX_SIDE=1024

# Optional extras
OCR_LANGUAGES=eng
DETECTION_MODEL=yolo11n.pt
DETECTION_CONFIDENCE=0.35

# Optional OpenTelemetry tracing (requires: uv sync --extra otel)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
