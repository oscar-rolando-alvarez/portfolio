{
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/account/{**catch-all}" }
      },
      "catalog": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "basket": {
        "ClusterId": "basket",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/basket/{**catch-all}" }
      },
      "ordering": {
        "ClusterId": "ordering",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "payment": {
        "ClusterId": "payment",
        "RateLimiterPolicy": "per-client",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "https+http://identity" } } },
      "catalog": { "Destinations": { "d1": { "Address": "https+http://catalog" } } },
      "basket": { "Destinations": { "d1": { "Address": "https+http://basket" } } },
      "ordering": { "Destinations": { "d1": { "Address": "https+http://ordering" } } },
      "payment": { "Destinations": { "d1": { "Address": "https+http://payment" } } }
    }
  },
  "Services": {
    "identity": { "http": [ "http://localhost:5100" ] },
    "catalog": { "http": [ "http://localhost:5101" ] },
    "basket": { "http": [ "http://localhost:5102" ] },
    "ordering": { "http": [ "http://localhost:5103" ] },
    "payment": { "http": [ "http://localhost:5104" ] }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
