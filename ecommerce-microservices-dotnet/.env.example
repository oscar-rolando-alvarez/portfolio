# Copy to .env and fill in. Never commit the real .env file.

# Shared HMAC key used by Identity to sign access tokens and by every service to validate them.
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=

# PostgreSQL superuser password used by identity, ordering and payment.
POSTGRES_PASSWORD=

# RabbitMQ credentials.
RABBITMQ_USER=ecommerce
RABBITMQ_PASSWORD=

# Optional: seed an admin account (role "admin") that can manage the catalog.
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=

# Charges above this amount are declined by the simulated payment gateway.
PAYMENT_APPROVAL_LIMIT=10000
